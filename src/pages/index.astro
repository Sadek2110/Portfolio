---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import InteractiveTerminal from '../components/islands/InteractiveTerminal.tsx';
import ProjectFilter from '../components/islands/ProjectFilter.tsx';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />
	
	<main class="space-y-12">
		{/* Hero Section */}
		<Hero />
		
		{/* Skills Bento Section */}
		<div class="border-t-2 border-zinc-200 dark:border-zinc-800">
			<SkillsGrid />
		</div>
		
		{/* PowerShell Interactive Terminal Section */}
		<section id="terminal" class="w-full border-t-2 border-zinc-200 dark:border-zinc-800 bg-zinc-100/50 dark:bg-zinc-950/20 py-16">
			<div class="max-w-6xl mx-auto px-4">
				<div class="mb-8 text-center md:text-left">
					<div class="inline-block px-3 py-1 border-2 border-zinc-950 dark:border-zinc-50 bg-blue-600 text-white font-heading font-black text-xs uppercase tracking-wider mb-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
						CONSOLA INTERACTIVA
					</div>
					<h2 class="text-3xl sm:text-5xl font-black font-heading tracking-tight uppercase text-zinc-950 dark:text-white">
						Explora en la PowerShell
					</h2>
					<p class="text-zinc-600 dark:text-zinc-400 mt-2 text-sm md:text-base max-w-xl">
						Una simulación de consola de comandos Windows en la que puedes consultar mis habilidades, objetivos y contacto. Haz clic en los botones rápidos o escribe comandos directamente.
					</p>
				</div>
				
				<InteractiveTerminal client:visible />
			</div>
		</section>
		
		{/* Projects Showcase Section */}
		<section id="projects" class="w-full border-t-2 border-zinc-200 dark:border-zinc-800 py-16">
			<div class="max-w-6xl mx-auto px-4">
				<div class="mb-12">
					<div class="inline-block px-3 py-1 border-2 border-zinc-950 dark:border-zinc-50 bg-emerald-400 text-zinc-950 font-heading font-black text-xs uppercase tracking-wider mb-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
						LÍNEAS DE TRABAJO
					</div>
					<h2 class="text-3xl sm:text-5xl font-black font-heading tracking-tight uppercase text-zinc-950 dark:text-white">
						Mis Proyectos
					</h2>
					<p class="text-zinc-600 dark:text-zinc-400 mt-2 text-sm md:text-base max-w-xl">
						Proyectos reales publicados en GitHub: automatizaciones en producción con Playwright y n8n, APIs de scraping, plataformas web full-stack y mi TFG de DAW.
					</p>
				</div>
				
				<ProjectFilter client:visible />
			</div>
		</section>
		
		{/* About Section */}
		<div class="border-t-2 border-zinc-200 dark:border-zinc-800">
			<About />
		</div>
	</main>
	
	<Footer />
</Layout>
