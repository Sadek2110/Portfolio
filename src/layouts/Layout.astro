---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/enhancements.css';
import { profile, skillGroups } from '../data/portfolio';
import Terminal from '../components/Terminal.astro';
import ContactChat from '../components/ContactChat.astro';
interface Props { title?: string; description?: string; cinematic?: boolean; }
const { title = `${profile.shortName} — Desarrollo web & automatización`, description = profile.headline, cinematic = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const image = Astro.site ? new URL('/media/social.jpg', Astro.site).href : '/media/social.jpg';
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: profile.name,
  jobTitle: profile.role, description: profile.headline,
  ...(Astro.site ? { url: Astro.site.href } : {}),
  sameAs: [profile.github, profile.linkedin].filter(Boolean),
  homeLocation: { '@type': 'Place', name: profile.location },
  knowsAbout: skillGroups.flatMap(group => group.skills),
};
---
<!doctype html>
<html lang={profile.locale} class:list={{ 'story-page': cinematic }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10110f" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Sadek Ben Jouda — Desarrollo web y automatización" />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical.href} /></>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <Terminal />
    <ContactChat />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
