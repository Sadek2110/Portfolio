---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Sadek Ben Jouda | DAW, Automatizaciones & Agentes IA", 
	description = "Portafolio profesional de Sadek Ben Jouda, estudiante de Desarrollo de Aplicaciones Web en España. Especializado en automatizaciones con n8n, desarrollo web (PHP/JS/Astro), arquitecturas de agentes de IA y despliegue en VPS." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Sadek Ben Jouda" />
		<meta name="robots" content="index, follow" />
		
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://sadek.dev" />
		<meta property="og:site_name" content="Portafolio Sadek Ben Jouda" />
		
		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		
		<!-- Icons & Fonts -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />

		<!-- Inline Script to prevent Theme Flash -->
		<script is:inline>
			(function () {
				const getTheme = () => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						return 'dark';
					}
					return 'light';
				};
				const theme = getTheme();
				if (theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
				window.localStorage.setItem('theme', theme);
			})();
		</script>
	</head>
	<body class="selection:bg-blue-600 selection:text-white antialiased">
		<slot />
	</body>
</html>

<style is:global>
	html {
		font-family: 'Space Grotesk', sans-serif;
	}
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Archivo', sans-serif;
	}
</style>
