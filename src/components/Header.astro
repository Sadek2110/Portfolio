---
import ThemeToggle from './islands/ThemeToggle';
---
<header class="sticky top-0 z-50 w-full border-b-2 border-zinc-950 dark:border-zinc-50 bg-blue-600/95 backdrop-blur-md shadow-[0px_3px_0px_0px_#18181b] dark:shadow-[0px_3px_0px_0px_#fafafa]">
  <div class="max-w-6xl mx-auto px-4 py-3.5 flex items-center justify-between">
    <a href="#" class="font-heading font-black text-lg md:text-xl tracking-tighter border-2 border-zinc-950 px-3.5 py-1 bg-white text-blue-600 shadow-[2px_2px_0px_0px_#18181b] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0px_0px_#18181b] transition-all duration-150">
      SADEK.DEV
    </a>
    
    <nav class="hidden md:flex items-center gap-8 font-heading font-black text-xs uppercase tracking-wider text-blue-50">
      <a href="#skills" class="hover:text-white transition-colors">Habilidades</a>
      <a href="#terminal" class="hover:text-white transition-colors">Terminal</a>
      <a href="#projects" class="hover:text-white transition-colors">Proyectos</a>
      <a href="#about" class="hover:text-white transition-colors">Sobre Mí</a>
      <a href="#contact" class="hover:text-white transition-colors">Contacto</a>
    </nav>
    
    <div class="flex items-center gap-3">
      <a href="#contact" class="px-4 py-2 text-xs font-heading font-black uppercase border-2 border-zinc-950 bg-zinc-950 text-white shadow-[2px_2px_0px_0px_#18181b] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0px_0px_#18181b] active:translate-x-0 active:translate-y-0 active:shadow-[1px_1px_0px_0px_#18181b] transition-all duration-150 cursor-pointer">
        Contacto
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</header>
