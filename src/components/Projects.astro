---
import { projects, moreProjects, allProjects } from '../data/portfolio';
import ProjectVisual from './ProjectVisual.astro';
import Icon from './Icon.astro';
---
<section class="section shell projects-section" id="proyectos" aria-labelledby="projects-title">
  <div class="section-kicker mono"><span>01 / TRABAJO SELECCIONADO</span><span>IDEAS QUE TOMAN FORMA</span></div>
  <div class="section-heading" data-reveal><h2 id="projects-title">Código con<br /><span class="serif-free">un propósito<span class="accent">.</span></span></h2><p>Proyectos personales y académicos.<br />Problemas cotidianos, soluciones propias.</p></div>
  <div class="project-filters" role="group" aria-label="Filtrar proyectos" hidden>
    <button class="filter-button is-active" data-filter="all" aria-pressed="true">Todos <span>{String(allProjects.length).padStart(2, '0')}</span></button>
    {(['Desarrollo web', 'Automatización'] as const).map(category => <button class="filter-button" data-filter={category} aria-pressed="false">{category} <span>{String(allProjects.filter(project => project.category === category).length).padStart(2, '0')}</span></button>)}
  </div>
  <p class="sr-only" data-filter-status aria-live="polite" role="status"></p>
  <div class="projects-grid">
    {projects.map((project, i) => <article class="project-card" data-project data-category={project.category}>
      <a class="project-image-link" href={`/proyectos/${project.slug}/`} aria-label={`Ver proyecto ${project.title}`}><ProjectVisual project={project} /></a>
      <div class="project-meta mono"><span>{project.type}</span><span class="project-status"><span></span>{project.status}</span></div>
      <div class="project-title-row"><h3><a href={`/proyectos/${project.slug}/`}>{project.title}</a></h3><a class="project-arrow" href={`/proyectos/${project.slug}/`} aria-label={`Leer el caso de ${project.title}`}><Icon /></a></div>
      <p class="project-description">{project.description}</p>
      <div class="project-tags">{project.stack.slice(0, 4).map(tech => <span>{tech}</span>)}</div>
      <span class="project-index mono" aria-hidden="true">0{i + 1}</span>
    </article>)}
  </div>
  <div class="project-archive" data-project-archive>
    <div class="archive-heading"><h3>Otras ideas en código<span class="accent">.</span></h3><span class="mono">EXPLORANDO OTROS PROBLEMAS</span></div>
    {moreProjects.map((project, index) => <article class="archive-row" data-project data-category={project.category}>
      <span class="archive-number mono">0{projects.length + index + 1}</span>
      <div class="archive-copy"><p class="mono">{project.type}</p><h4><a href={`/proyectos/${project.slug}/`}>{project.title}</a></h4><p>{project.description}</p><span class="archive-status mono">{project.status}</span></div>
      <div class="archive-stack project-tags">{project.stack.slice(0, 3).map(tech => <span>{tech}</span>)}</div>
      <a class="project-arrow" href={`/proyectos/${project.slug}/`} aria-label={`Ver proyecto ${project.title}`}><Icon /></a>
    </article>)}
  </div>
  <a class="text-link all-projects" href="https://github.com/Sadek2110?tab=repositories" target="_blank" rel="noopener noreferrer">Más código en GitHub <Icon size={17} /></a>
</section>
