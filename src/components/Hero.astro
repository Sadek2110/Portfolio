---
import { profile } from '../data/portfolio';
import Icon from './Icon.astro';
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-stage">
    <div class="hero-media" aria-hidden="true">
      <img class="hero-poster" src="/media/hero-poster.webp" alt="" width="1280" height="720" fetchpriority="high" />
      <video class="hero-video" muted playsinline preload="none" poster="/media/hero-poster.webp" data-src="/media/hero.mp4" tabindex="-1"></video>
    </div>
    <div class="hero-grain" aria-hidden="true"></div>
    <div class="hero-topline shell mono"><span>PORTFOLIO PERSONAL / 2026</span><span>DESARROLLO CON PROPÓSITO</span></div>
    <div class="hero-content shell">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> DESARROLLO WEB & AUTOMATIZACIÓN</p>
        <h1 id="hero-title">SADEK<span>BEN JOUDA<span class="accent">.</span></span></h1>
        <p class="hero-fullname mono">SADEK BEN JOUDA AKIL · CEUTA, ESPAÑA</p>
        <p class="hero-description">{profile.headline}</p>
        <div class="hero-actions flex flex-wrap gap-3">
          <a class="button button-primary" href="#proyectos">Ver proyectos <Icon name="down" size={18} /></a>
          <a class="button button-ghost" href="#contacto">Contactar <Icon size={18} /></a>
        </div>
      </div>
    </div>
    <div class="hero-bottom shell">
      <div class="media-caption mono"><span class="small-cross">+</span> RETRATO ANIMADO CON IA<br /><span class="caption-indent">A PARTIR DEL VÍDEO APORTADO</span></div>
      <button class="video-toggle mono" data-video-toggle hidden aria-pressed="false">Reproducir vídeo <span aria-hidden="true">↗︎</span></button>
      <a class="scroll-cue mono" href="#proyectos"><span>SCROLL PARA EXPLORAR</span><span class="scroll-circle"><Icon name="down" size={16} /></span></a>
    </div>
  </div>
</section>
<div class="discipline-strip" aria-label="Especialidades">
  <div class="shell"><span>DESARROLLO WEB</span><span aria-hidden="true">✳</span><span>AUTOMATIZACIÓN</span><span aria-hidden="true">✳</span><span>INTELIGENCIA ARTIFICIAL</span><span aria-hidden="true">✳</span><span>IDEAS EN MOVIMIENTO</span></div>
</div>
