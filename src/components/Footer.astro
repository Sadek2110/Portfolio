---
---
<footer id="contact" class="w-full bg-zinc-950 text-zinc-100 border-t-4 border-zinc-950 dark:border-zinc-50 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
    
    {/* Column 1: Info */}
    <div class="md:col-span-5 flex flex-col items-start gap-4">
      <span class="font-heading font-black text-2xl tracking-tighter border-2 border-zinc-50 px-4 py-1 bg-blue-600 text-white shadow-[2px_2px_0px_0px_#fafafa]">
        SADEK.DEV
      </span>
      <p class="text-sm text-zinc-400 max-w-sm leading-relaxed">
        Estudiante de Desarrollo de Aplicaciones Web enfocado en la construcción de sistemas autónomos, automatizaciones complejas y arquitecturas de agentes de inteligencia artificial.
      </p>
      <span class="text-xs font-mono px-2 py-1 bg-zinc-800 text-zinc-300 border border-zinc-700">
        📍 Ceuta, España (UTC+2)
      </span>
    </div>

    {/* Column 2: Navigation Links */}
    <div class="md:col-span-3">
      <h3 class="font-heading font-black text-sm uppercase tracking-wider text-white mb-4 border-b border-zinc-800 pb-2">
        Navegación
      </h3>
      <ul class="space-y-2.5 text-sm text-zinc-400 font-bold">
        <li><a href="#hero" class="hover:text-blue-400 transition-colors">Inicio</a></li>
        <li><a href="#skills" class="hover:text-blue-400 transition-colors">Habilidades</a></li>
        <li><a href="#terminal" class="hover:text-blue-400 transition-colors">Terminal</a></li>
        <li><a href="#projects" class="hover:text-blue-400 transition-colors">Proyectos</a></li>
        <li><a href="#about" class="hover:text-blue-400 transition-colors">Sobre Mí</a></li>
      </ul>
    </div>

    {/* Column 3: Contact & Links */}
    <div class="md:col-span-4 flex flex-col gap-4">
      <h3 class="font-heading font-black text-sm uppercase tracking-wider text-white mb-1 border-b border-zinc-800 pb-2">
        Contacto y Redes
      </h3>
      
      <div class="flex flex-col gap-2.5">
        {/* GitHub Button */}
        <a
          href="https://github.com/Sadek2110"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-4 py-2 border-2 border-zinc-50 bg-zinc-900 text-zinc-50 font-mono font-bold text-xs uppercase tracking-wider hover:bg-zinc-800 shadow-[2px_2px_0px_0px_#fafafa] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0px_0px_#fafafa] active:translate-x-0 active:translate-y-0 active:shadow-[1px_1px_0px_0px_#fafafa] transition-all cursor-pointer"
        >
          <span>GitHub (Sadek2110)</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.2 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
        </a>

        {/* Telegram Button */}
        <a
          href="https://t.me/+34616863398"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-4 py-2 border-2 border-zinc-50 bg-blue-600 text-zinc-50 font-mono font-bold text-xs uppercase tracking-wider hover:bg-blue-700 shadow-[2px_2px_0px_0px_#fafafa] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0px_0px_#fafafa] active:translate-x-0 active:translate-y-0 active:shadow-[1px_1px_0px_0px_#fafafa] transition-all cursor-pointer"
        >
          <span>Telegram (616 863 398)</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
        </a>

        {/* Phone Button */}
        <a
          href="tel:+34616863398"
          class="flex items-center justify-between px-4 py-2 border-2 border-zinc-50 bg-zinc-900 text-zinc-50 font-mono font-bold text-xs uppercase tracking-wider hover:bg-zinc-800 shadow-[2px_2px_0px_0px_#fafafa] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0px_0px_#fafafa] active:translate-x-0 active:translate-y-0 active:shadow-[1px_1px_0px_0px_#fafafa] transition-all cursor-pointer"
        >
          <span>Teléfono (616 863 398)</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </a>

        {/* Email Button */}
        <a
          href="mailto:sadekjoud@gmail.com"
          class="flex items-center justify-between px-4 py-2 border-2 border-zinc-50 bg-zinc-900 text-zinc-50 font-mono font-bold text-xs uppercase tracking-wider hover:bg-zinc-800 shadow-[2px_2px_0px_0px_#fafafa] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0px_0px_#fafafa] active:translate-x-0 active:translate-y-0 active:shadow-[1px_1px_0px_0px_#fafafa] transition-all cursor-pointer"
        >
          <span>sadekjoud@gmail.com</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  {/* Copyright Bar */}
  <div class="border-t border-zinc-800 bg-zinc-950 py-6 px-4">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 font-mono">
      <span>&copy; {new Date().getFullYear()} Sadek Ben Jouda. Todos los derechos reservados.</span>
      <div class="flex items-center gap-1.5 bg-zinc-900 px-3 py-1 border border-zinc-800">
        <span>Diseñado en Ceuta con 🚀 Astro & ⚛️ React</span>
      </div>
    </div>
  </div>
</footer>
