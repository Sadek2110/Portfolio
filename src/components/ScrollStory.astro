---
import { profile, projects, allProjects } from '../data/portfolio';
import Icon from './Icon.astro';
import '../styles/story.css';
---
<div class="scroll-story" data-scroll-story>
  <div class="story-backdrop">
    <div class="story-bottom shell">
      <span class="story-location mono">CEUTA, ESPAÑA / DAW 2026</span>
    </div>
  </div>
  <div class="story-chapters">
    <section class="story-chapter story-intro" id="inicio" data-chapter aria-labelledby="story-name">
      <div class="story-portrait" aria-hidden="true"><img class="story-poster" src="/media/hero-poster.webp" width="1280" height="720" alt="" fetchpriority="high" /><div class="portrait-shade"></div></div>
      <div class="story-topline shell mono"><span>SADEK BEN JOUDA AKIL / PORTFOLIO</span><span>UNA IDEA. MUCHAS POSIBILIDADES.</span></div>
      <div class="chapter-shell shell intro-shell"><div class="chapter-content">
        <p class="story-eyebrow mono" data-story-reveal><span class="status-dot"></span> DESARROLLO WEB · AUTOMATIZACIÓN · IA</p>
        <h1 id="story-name" data-story-reveal>SADEK<span>BEN JOUDA<span class="accent">.</span></span></h1>
        <p class="story-lead" data-story-reveal>{profile.headline}</p>
        <div class="story-actions" data-story-reveal><a href="#proyectos" class="button button-primary">Ver proyectos <Icon name="down" size={17} /></a><a href="#contacto" class="story-text-link">Contactar <Icon size={16} /></a></div>
        <a class="story-scroll-note mono" href="#sobre-mi" data-story-reveal><span class="scroll-line" aria-hidden="true"></span> SIGUE BAJANDO. TE CUENTO.</a>
      </div></div>
      <span class="portrait-credit mono">RETRATO DEL VÍDEO APORTADO · IA</span>
    </section>

    <section class="story-chapter story-about" id="sobre-mi" data-chapter aria-labelledby="story-about">
      <span class="chapter-watermark" aria-hidden="true">02—05</span>
      <div class="chapter-shell shell chapter-split">
        <div class="chapter-heading"><p class="story-eyebrow mono" data-story-reveal>02 / LA PERSONA DETRÁS DEL CÓDIGO</p><h2 id="story-about" data-story-reveal>Curiosidad.<br />Código.<br /><span class="accent">Propósito.</span></h2><span class="profile-glyph" aria-hidden="true" data-story-reveal>&lt;/&gt;</span></div>
        <div class="chapter-detail"><div class="story-rule" aria-hidden="true"></div><p class="story-lead" data-story-reveal>Soy Sadek, desarrollador web de Ceuta. Me gusta entender los problemas y convertirlos en herramientas que simplifican el día a día.</p><div class="story-credentials" data-story-reveal><div><span class="mono">FORMACIÓN</span><strong>Desarrollo de<br />Aplicaciones Web</strong></div><div><span class="mono">MI ENFOQUE</span><strong>Web, automatización<br />e inteligencia artificial</strong></div></div><a class="story-text-link" href="/perfil/" data-story-reveal>Un poco más sobre mí <Icon size={17} /></a></div>
      </div>
    </section>

    <section class="story-chapter story-work" id="proyectos" data-chapter aria-labelledby="story-projects">
      <div class="chapter-shell shell chapter-split">
        <div class="chapter-heading"><p class="story-eyebrow mono" data-story-reveal>03 / DEL «Y SI…» AL CÓDIGO</p><h2 id="story-projects" data-story-reveal>Ideas que<br /><span class="accent">toman forma.</span></h2><p class="story-lead" data-story-reveal>Proyectos personales.<br />Problemas reales. Soluciones propias.</p><a class="story-text-link" href="/proyectos/" data-story-reveal>Explorar los {allProjects.length} proyectos <Icon name="arrow" size={18} /></a></div>
        <div class="story-projects">{projects.slice(0, 3).map((project, i) => <a class="story-project" href={'/proyectos/' + project.slug + '/'} aria-label={'Ver proyecto ' + project.title} data-story-reveal><span class="story-project-index mono">0{i + 1}</span><div><h3>{project.title}</h3><p>{project.slug === 'gymflow' ? 'Planificar, entrenar y seguir el progreso.' : project.slug === 'fastplay' ? 'Equipos y competiciones de fútbol local.' : 'Reservas deportivas que se hacen solas.'}</p><span class="mono">{project.status}</span></div><span class="story-project-arrow"><Icon size={21} /></span></a>)}</div>
      </div>
    </section>

    <section class="story-chapter story-approach" id="infraestructura" data-chapter aria-labelledby="story-approach">
      <span id="tecnologias" class="story-alias" aria-hidden="true"></span>
      <div class="chapter-shell shell chapter-split">
        <div class="chapter-heading"><p class="story-eyebrow mono" data-story-reveal>04 / MI FORMA DE CONSTRUIR</p><h2 id="story-approach" data-story-reveal>Conectar<br /><span class="accent">las piezas.</span></h2><p class="story-lead" data-story-reveal>De una interfaz clara a una tarea que se hace sola. Desarrollo, automatización e infraestructura propia para dar forma a cada idea.</p><a class="story-text-link" href="/perfil/#infraestructura" data-story-reveal>Así encajan mis proyectos <Icon size={17} /></a></div>
        <div class="approach-visual"><span class="approach-caption mono" data-story-reveal>DE LA IDEA AL DESPLIEGUE</span><ol class="approach-nodes"><li data-story-reveal><span class="mono">01</span><div><strong>Construir</strong><span>Astro · React · Node.js</span></div><Icon name="plus" size={22} /></li><li data-story-reveal><span class="mono">02</span><div><strong>Conectar</strong><span>APIs · n8n · Playwright</span></div><Icon name="plus" size={22} /></li><li data-story-reveal><span class="mono">03</span><div><strong>Desplegar</strong><span>Docker · VPS · EasyPanel</span></div><Icon size={22} /></li></ol><span class="approach-note mono" data-story-reveal>ENTENDER → DISEÑAR → CONSTRUIR → AUTOMATIZAR</span></div>
      </div>
    </section>

    <section class="story-chapter story-contact" id="contacto" data-chapter aria-labelledby="story-contact">
      <div class="chapter-shell shell contact-shell">
        <div class="chapter-content">
          <p class="story-eyebrow mono" data-story-reveal>05 / LAS IDEAS EMPIEZAN HABLANDO</p>
          <h2 id="story-contact" data-story-reveal>La próxima<br />idea puede ser<br /><span>la tuya.</span></h2>
          <p class="story-lead" data-story-reveal>Una web, una automatización o algo que todavía estás imaginando.</p>
          <div class="story-contact-details" data-story-reveal>
            <a href={'mailto:' + profile.email}><span class="mono">ESCRÍBEME</span>{profile.email}<Icon size={19} /></a>
            <a href={profile.phoneHref}><span class="mono">LLÁMAME</span>{profile.phone}<Icon size={19} /></a>
          </div>
          <div class="story-contact-links" data-story-reveal><a href="/proyectos/">Ver mi trabajo <Icon size={14} /></a><button type="button" data-terminal-open hidden aria-haspopup="dialog" aria-controls="portfolio-terminal"><span aria-hidden="true">&gt;_</span> Explorar la terminal</button></div>
        </div>
        <button class="contact-symbol" type="button" data-contact-chat-open hidden aria-label="Abrir chat con Sadek" aria-haspopup="dialog" aria-controls="contact-chat" data-story-reveal><Icon size={130} /><span class="mono">HABLEMOS · ABRIR CHAT</span></button>
      </div>
    </section>
  </div>
</div>
<script>
  import '../scripts/story';
</script>
